{
    "name": "jord-sentinel",
    "private": true,
    "version": "1.0.0",
    "description": "Plataforma de inteligência geoespacial para validação ambiental de imóveis rurais conforme o Manual de Crédito Rural (MCR).",
    "workspaces": [
        "backend",
        "frontend"
    ],
    "scripts": {
        "prepare": "husky",
        "front": "npm run -w frontend dev",
        "back": "npm run -w backend start:dev",
        "migrate": "node backend/src/database/postgres/migrations/migrate.js",
        "seed": "node backend/src/database/postgres/seeds/seed.js",
        "start": "concurrently \"npm run back\" \"npm run front\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "concurrently": "^10.0.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.2.0"
    }
}
